local headerRaw = "codded by xzen"
local headerPhase = 0

local function renderHeaderGradient()
    local out = ""
    local n = #headerRaw
    for i = 1, n do
        local ch = headerRaw:sub(i,i)
        if ch == " " then
            out = out .. " "
        else
            local wave = math.sin((i / n) * math.pi * 2 - headerPhase)
            local t = (wave + 1) * 0.5
            local col = Color3.fromRGB(255,255,255):Lerp(Color3.fromRGB(0,0,0), t)
            out = out .. '<font color="#' .. col:ToHex() .. '">' .. ch .. '</font>'
        end
    end
    headerText.Text = out
end

TrackConnection(RunService.RenderStepped:Connect(function(dt)
    if not Active then return end
    headerPhase = headerPhase + dt * 3
    renderHeaderGradient()
end))
renderHeaderGradient()

