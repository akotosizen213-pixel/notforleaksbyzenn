local ToggleRefs = {}
local function BuildToggle(feature, order, layoutParent)
    local state=false
    local row=New("TextButton",{ Text="", AutoButtonColor=false, LayoutOrder=order, Size=UDim2.new(1,-6,0,32), BackgroundColor3=Color3.fromRGB(0,0,0), BackgroundTransparency=1, BorderSizePixel=0, ZIndex=5 })
    local icon = New("Frame",{ Size=UDim2.fromOffset(12,12), Position=UDim2.fromOffset(12,10), BackgroundColor3=THEME.Off, BorderSizePixel=1, BorderColor3=THEME.Stroke, ZIndex=6 })
    icon.Parent=row
    New("TextLabel",{ Text=feature.name, Font=Enum.Font.Code, TextSize=14, TextColor3=THEME.Text, BackgroundTransparency=1, Position=UDim2.fromOffset(34,0), Size=UDim2.new(0.6,0,1,0), TextXAlignment=Enum.TextXAlignment.Left, ZIndex=6 }).Parent=row
    if feature.desc ~= "" then
        New("TextLabel",{ Text=feature.desc, Font=Enum.Font.Code, TextSize=12, TextColor3=THEME.SubText, BackgroundTransparency=1, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-10,0.5,0), Size=UDim2.fromOffset(100,16), TextXAlignment=Enum.TextXAlignment.Right, ZIndex=6 }).Parent=row
    end
    local function Render(anim) icon.BackgroundColor3 = state and THEME.On or THEME.Off end
    OnAccentChanged(function(c) if state then icon.BackgroundColor3 = c end end)
    TrackConnection(row.MouseButton1Click:Connect(function() state=not state; Render(true); Settings:Set(feature.id,state) end))
    TrackConnection(row.MouseEnter:Connect(function() row.BackgroundColor3=Color3.fromRGB(255,255,255); row.BackgroundTransparency=0.85 end))
    TrackConnection(row.MouseLeave:Connect(function() row.BackgroundTransparency=1 end))
    Render(false)
    row.Parent=layoutParent
    ToggleRefs[feature.id] = {Render=Render, SetState=function(v) if v~=state then state=v; Render(true) end end}
end

