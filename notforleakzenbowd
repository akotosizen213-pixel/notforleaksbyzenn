local SilentAim = {}
SilentAim.Enabled = false
SilentAim.FOV = fovRadius
SilentAim.MaxDistance = 1000
SilentAim.TeamCheck = false
SilentAim.WallCheck = false
SilentAim.TargetPart = aimBone
SilentAim.Prediction = 0.0

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function isAlive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getPart(char, name)
    return char:FindFirstChild(name) or char:FindFirstChild("HumanoidRootPart")
end

local function worldToScreen(pos)
    local screen, onScreen = camera:WorldToViewportPoint(pos)
    return Vector2.new(screen.X, screen.Y), onScreen
end

function SilentAim.getTarget()
    if not SilentAim.Enabled then return nil end
    local char = player.Character
    if not char then return nil end
    local myHum = char:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then return nil end

    local camPos = camera.CFrame.Position
    local center = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)
    local best, bestScore = nil, SilentAim.FOV

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and isAlive(plr) then
            if not (SilentAim.TeamCheck and plr.Team == player.Team) then
                local pchar = plr.Character
                local part = getPart(pchar, SilentAim.TargetPart)
                if part then
                    local dist = (part.Position - camPos).Magnitude
                    if dist <= SilentAim.MaxDistance then
                        local ok = true
                        if SilentAim.WallCheck then
                            rayParams.FilterDescendantsInstances = {char, camera}
                            local dir = part.Position - camPos
                            local hit = Workspace:Raycast(camPos, dir, rayParams)
                            if hit and hit.Instance:IsDescendantOf(pchar) == false then
                                ok = false
                            end
                        end
                        if ok then
                            local aimPos = part.Position
                            if SilentAim.Prediction > 0 then
                                local vel = part.AssemblyLinearVelocity
                                local travel = dist / 1000
                                aimPos = aimPos + vel * travel * SilentAim.Prediction
                            end
                            local scr, onScreen = worldToScreen(aimPos)
                            if onScreen then
                                local score = (scr - center).Magnitude
                                if score < bestScore then
                                    bestScore = score
                                    best = part
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

function SilentAim.redirect(originCFrame)
    if not SilentAim.Enabled then return originCFrame end
    local target = SilentAim.getTarget()
    if not target then return originCFrame end
    local from = originCFrame.Position
    local dir = target.Position - from
    if dir.Magnitude < 0.001 then return originCFrame end
    return CFrame.lookAt(from, from + dir.Unit)
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        SilentAim.Enabled = not SilentAim.Enabled
        Settings:Set("SilentAim", SilentAim.Enabled)
        if ToggleRefs["SilentAim"] then ToggleRefs["SilentAim"].SetState(SilentAim.Enabled) end
    end
end)

