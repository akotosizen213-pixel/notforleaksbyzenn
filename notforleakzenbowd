task.spawn(function()
    local modulePath = ReplicatedStorage:WaitForChild("Blaster", 10)
    if modulePath then modulePath = modulePath:WaitForChild("Scripts", 10) end
    if modulePath then modulePath = modulePath:WaitForChild("BlasterController", 10) end
    if not modulePath then
        warn("[Fatchoi] BlasterController not found — menu only")
        return
    end
    local okMod, Controller = pcall(require, modulePath)
    if not okMod or type(Controller) ~= "table" then
        warn("[Fatchoi] could not require BlasterController")
        return
    end
    local Hooks = { shoot = {}, getShotOrigin = {}, setAiming = {} }

    local function hookAlive(plr)
        local char = plr.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        return true
    end

    local function hookWorldToScreen(pos)
        local sp, onScreen = camera:WorldToViewportPoint(pos)
        return Vector2.new(sp.X, sp.Y), onScreen
    end

    local function hookValidTarget(plr, silent)
        if plr == player then return false end
        if not hookAlive(plr) then return false end
        if silent.TeamCheck and plr.Team ~= nil and plr.Team == player.Team then return false end
        return true
    end

    local function hookTargetPart(plr, silent)
        local char = plr.Character
        if not char then return nil end
        local name = silent.TargetPart or "Head"
        local part = char:FindFirstChild(name) or char:FindFirstChild("HumanoidRootPart")
        if not part or not part:IsA("BasePart") then return nil end
        return part
    end

    local function hookWallBlocked(origin, targetPos, targetChar)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { player.Character, targetChar }
        local ray = Workspace:Raycast(origin, targetPos - origin, params)
        if not ray then return false end
        return true
    end

    local function hookGetClosestHead(silent)
        local best, bestDist = nil, math.huge
        local center = camera.ViewportSize / 2
        local camPos = camera.CFrame.Position
        local maxDist = silent.MaxDistance or 1000
        for _, plr in ipairs(Players:GetPlayers()) do
            if hookValidTarget(plr, silent) then
                local part = hookTargetPart(plr, silent)
                if part then
                    local dist3d = (part.Position - camPos).Magnitude
                    if dist3d <= maxDist then
                        local screenPos, onScreen = hookWorldToScreen(part.Position)
                        if onScreen then
                            local dist = (screenPos - center).Magnitude
                            if dist <= silent.FOV and dist < bestDist then
                                if not silent.WallCheck or not hookWallBlocked(camPos, part.Position, plr.Character) then
                                    best, bestDist = part, dist
                                end
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    local function hookAimAt(targetPart)
        if not targetPart then return end
        local origin = camera.CFrame.Position
        local dir = (targetPart.Position - origin)
        if dir.Magnitude < 0.001 then return nil end
        return CFrame.lookAt(origin, origin + dir.Unit), dir.Magnitude
    end

    local function wrap(class, name, list)
        local original = class[name]
        if type(original) ~= "function" then
            warn("[Fatchoi] missing method:", name)
            return
        end
        class[name] = function(self, ...)
            local args = table.pack(...)
            local override, overrideRet = nil, nil
            for i = 1, #list do
                local o, r = list[i].pre(self, table.unpack(args, 1, args.n))
                if o then 
                    override, overrideRet = true, r 
                    break 
                end
            end
            local ret
            if override then
                ret = table.pack(overrideRet)
            else
                local okCall, r1 = pcall(original, self, table.unpack(args, 1, args.n))
                if okCall then
                    ret = table.pack(r1)
                else
                    warn("[Fatchoi] original errored:", name, r1)
                    ret = table.pack(nil)
                end
            end
            for i = 1, #list do
                if list[i].post then
                    list[i].post(self, ret, table.unpack(args, 1, args.n))
                end
            end
            return table.unpack(ret, 1, ret.n or #ret)
        end
    end

    table.insert(Hooks.getShotOrigin, {
        pre = function(self, ...)
            local silent = getgenv().XENZEN_SilentAim
            if not silent or not silent.Enabled then return false end
            local head = hookGetClosestHead(silent)
            if not head then return false end
            local origin = self:getMuzzlePosition()
            if not origin then return false end
            local cf, distance = hookAimAt(head)
            if not cf then return false end
            return true, cf, distance
        end,
    })

    table.insert(Hooks.shoot, {
        pre = function(self, ...)
            local silent = getgenv().XENZEN_SilentAim
            if not silent or not silent.Enabled then return false end
            local head = hookGetClosestHead(silent)
            if not head then return false end
            self._silentTarget = head
            return false
        end,
    })

    for name, list in pairs(Hooks) do
        wrap(Controller, name, list)
    end

    _G.FatchoiSilentAim = {
        getClosestHead = function() return hookGetClosestHead(getgenv().XENZEN_SilentAim) end,
        isEnabled = function() local s = getgenv().XENZEN_SilentAim; return s and s.Enabled end,
    }
    print("[Fatchoi] Blaster hook attached")
end)

