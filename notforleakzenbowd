local function New(class, props, children)
    local o = Instance.new(class)
    for k,v in pairs(props) do o[k]=v end
    for _,c in ipairs(children or {}) do c.Parent=o end
    return TrackInstance(o)
end
local function Tween(o,t,p,s) TweenService:Create(o,TweenInfo.new(t,s or Enum.EasingStyle.Linear),p):Play() end

local function MakeDraggable(frame, handle)
    local dragging, dragStart, startPos, activeTouch
    TrackConnection(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = frame.Position
            if input.UserInputType == Enum.UserInputType.Touch then activeTouch = input end
        end
    end))
    TrackConnection(handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false; activeTouch = nil end
    end))
    TrackConnection(UserInputService.InputChanged:Connect(function(input)
        if not Active or not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if input.UserInputType == Enum.UserInputType.Touch and activeTouch and input ~= activeTouch then return end
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))
    TrackConnection(UserInputService.TouchEnded:Connect(function() if dragging then dragging = false; activeTouch = nil end end))
end

local Accent = { Current = Color3.fromRGB(255,255,255), Target = Color3.fromRGB(255,255,255) }
local AccentListeners = {}
local function OnAccentChanged(fn) table.insert(AccentListeners, fn); fn(Accent.Current) end
local function SetAccent(color) Accent.Target = color end
TrackConnection(RunService.RenderStepped:Connect(function(dt)
    if not Active then return end
    if Accent.Current ~= Accent.Target then
        Accent.Current = Accent.Current:Lerp(Accent.Target, math.clamp(dt * 6, 0, 1))
        for _, fn in ipairs(AccentListeners) do fn(Accent.Current) end
    end
end))

